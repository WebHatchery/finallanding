 "endings": [
  {
   "id": "beacon",
   "name": "Beacon",
   "pitch": "Repair the long-range array and call the fleet. Rescue, reunion, and a place in humanity's story.",
   "capstone_tech": "deep_space_beacon",
   "capstone_building": "beacon_array",
   "final_crisis_event": "fleet_static",
   "epilogue": "The fleet answered. Three months later, shuttles burned down through the clouds onto the plain where the Meridian fell. The colonists who walked out to meet them were no longer crew; they were the first people of a new world, and the fleet would learn that from them."
  },
  {
   "id": "rootbound",
   "name": "Rootbound",
   "pitch": "Join the colony to the planet's living network. Become native, and never be alone again.",
   "capstone_tech": "biosphere_communion",
   "capstone_building": "verdant_heart",
   "final_crisis_event": "root_fever",
   "epilogue": "The grove took root, and the colony with it. Crops grew where no crops should, fevers broke in a night, and the survivors dreamed the planet's slow dreams. When the fleet finally came, it found a people who no longer needed rescue."
  },
  {
   "id": "ascendant",
   "name": "Ascendant",
   "pitch": "Wake the precursor spire and inherit what the first civilisation left behind.",
   "capstone_tech": "spire_resonance",
   "capstone_building": "spire_conduit",
   "final_crisis_event": "spire_awakening",
   "epilogue": "The spire woke. Light ran through the ground like water, and the precursors' archive opened to the colony's halting songs. They had crashed as refugees; they rose as heirs to a knowledge older than Earth."
  }
 ],
